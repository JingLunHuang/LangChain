# uv run --env-file .env ... ; never commit .env
AGENT_PLATFORM_DEMO=1
# 多模型目錄：先複製 models.example.json；示範模式會固定使用離線目錄。
PLATFORM_MODELS_FILE=
# Explicit bootstrap entries: key:tenant,key:tenant. No implicit development key.
PLATFORM_API_KEYS=
PLATFORM_ADMIN_KEY=
PLATFORM_MCP_KEY=
PLATFORM_KEY_DB=.state/keys.sqlite3
# Real providers: turn demo off and configure compatible chat and embedding APIs.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
EMBEDDING_MODEL=
# embedding 可使用獨立端點與金鑰，切換聊天模型不會重建資料索引。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# 多模型範例目錄只填環境變數名稱，金鑰放在此本機檔案。
FAST_MODEL=
FAST_API_KEY=
FAST_BASE_URL=
CODE_MODEL=
CODE_API_KEY=
CODE_BASE_URL=
REASON_MODEL=
REASON_API_KEY=
REASON_BASE_URL=
CLAUDE_MODEL=
ANTHROPIC_API_KEY=
GEMINI_MODEL=
GOOGLE_API_KEY=
# Optional shared public knowledge folder; private tenant maps never fall back.
AGENT_PLATFORM_DOCS_PATH=
AGENT_PLATFORM_TENANT_DOCS={}
PLATFORM_MCP_SERVERS=[]
# 選用回答審查：需在請求中明確設定 review=true；資料會送至啟用的評估供應商。
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# 逗號分隔，最多兩個；填 models.json 中與產生回答的模型不同的 ID。
AGENT_PLATFORM_REVIEWER_MODELS=
